# Copy to .env (`cp .env.example .env`). Real values never go in git: .env is ignored.
# These are local-development defaults only.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_dev_password
POSTGRES_DB=booking
POSTGRES_PORT=5432
DATABASE_URL=postgres://booking:booking_dev_password@localhost:5432/booking
# Sign-in (OpenID Connect). The local identity provider arrives in a later step.
OIDC_ISSUER=http://localhost:8080/realms/booking
OIDC_AUDIENCE=booking-api
